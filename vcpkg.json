{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "jk",
    "description": "Joker's C++ Kit",
    "version": "2.4.0",
    "license": "MIT",
    "features": {
        "log": {
            "description": "spdlog support",
            "dependencies": [
                {
                    "name": "spdlog",
                    "features": [
                        "fmt",
                        "tz-offset",
                        "wchar"
                    ]
                },
                "fmt"
            ]
        }
    }
}